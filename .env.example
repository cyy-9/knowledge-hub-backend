POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_SYNCHRONIZE=true

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=mongodb
MONGODB_PASSWORD=mongodb
MONGODB_DB=knowledge_hub

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=knowledge-hub:

# Skill Playground AI 试用（无表方案）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# 百炼 Qwen 混合思考模型：默认关闭思考以加快试用响应
# SKILL_TRIAL_ENABLE_THINKING=false
# SKILL_TRIAL_THINKING_BUDGET=1024
# 试用对话 temperature，略高以增加措辞多样性（0–2，默认 0.7）
# SKILL_TRIAL_TEMPERATURE=0.7
# agent loop 最大步数（含 run_script 调用），默认 5
# SKILL_TRIAL_MAX_STEPS=5

# Skill 脚本执行（Phase 1 + 2，Docker 沙箱）
# SKILL_SCRIPT_ENABLED=true
# 生产建议 true；本地无 Docker 时可设为 false（降级为本地 node，无隔离）
# SKILL_SCRIPT_USE_DOCKER=true
# IDE 启动后端时 PATH 可能找不到 docker，本地 macOS 可显式指定：
# SKILL_SCRIPT_DOCKER_BIN=/usr/local/bin/docker
# Linux 服务器常见为 /usr/bin/docker；若已在 PATH 中可不配置，由自动解析处理
# SKILL_SCRIPT_DOCKER_IMAGE=skill-sandbox-node:latest
# SKILL_SCRIPT_TIMEOUT_MS=10000
# SKILL_SCRIPT_MAX_STDOUT_BYTES=65536
# SKILL_SCRIPT_MAX_CONCURRENT=5
# SKILL_SCRIPT_DOCKER_MEMORY=128m
# SKILL_SCRIPT_DOCKER_CPUS=0.5
# SKILL_SCRIPT_WORKSPACE_DIR=./tmp/skill-trial
# 可为相对或绝对路径，写入时会 resolve 为绝对路径（Docker 挂载要求）
# SKILL_SCRIPT_WORKSPACE_TTL_HOURS=24
